# Секреты
.env

# Данные (скачиваются/генерируются, не коммитим)
data/raw/
data/interim/
data/processed/
data/cache/
# но reference/ коммитим — там маленькие справочники
!data/reference/

# Результаты
outputs/maps/
outputs/tables/
outputs/figures/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
venv/
.venv/

# Пропозалы и внутренние документы заказчика — не в репозиторий
Пропозал*.md
*SETO*.md
# ...но README стенда — наша документация, а не документ заказчика
!docs/SETO_README.md
Геоаналитика_*.md

# SETO: сырые загрузки и результаты прогонов (не коммитим, восстанавливаются по манифесту)
raw/
runs/
cache/
# Рабочие документы (решение 12.11, Д22): вне git, чтобы их можно было править во время
# прогонов по протоколу. Их контрольные суммы на момент заморозки хранит протокол.
/docs/MADRID_DATA.md
/docs/PROPOSAL_CHANGES.md
/docs/TODO_V2.md
# Папка freeze-protocol по умолчанию: файлы протокола в git-дереве сделали бы его
# грязным, а их коммит сменил бы коммит протокола. В обоих случаях сверка откажет.
/protocol/
